{
  "name": "ai-chat-frontend",
  "private": true,
  "version": "0.10.15",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && cross-env NODE_ENV=development electron .",
    "build:electron": "vite build && electron-builder --win --config",
    "configure-build": "node scripts/configure-build.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.10.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/minimist": "^1.2.5",
    "@types/normalize-package-data": "^2.4.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.aichat.desktop",
    "productName": "Kasalix AI Chat",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../icon_client.png",
        "to": "icon.png"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "C:\\Users\\filik\\OneDrive\\Dokumenty\\Ai_Chat\\icon_client.png",
      "sign": false,
      "signAndEditExecutable": true
    },
    "nsis": {
      "license": "license.txt",
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "guid": "com-aichat-desktop",
      "createDesktopShortcut": true,
      "shortcutName": "Kasalix AI Chat",
      "artifactName": "Kasalix-AI-Chat-Setup-${version}.exe",
      "runAfterFinish": true,
      "include": "installer.nsh"
    },
    "publish": {
      "provider": "generic",
      "url": "",
      "channel": "latest"
    }
  },
  "description": "Kasalix AI Chat Client",
  "author": "Filip Kasman",
  "license": "Apache-2.0"
}
