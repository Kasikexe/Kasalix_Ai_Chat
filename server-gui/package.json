{
  "name": "kasalix-server-gui",
  "version": "0.11.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win --config",
    "build:portable": "electron-builder --win portable --config"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kasalix.server",
    "productName": "Kasalix AI Chat Server",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../certs",
        "to": "certs"
      },
      {
        "from": "../icon_server.png",
        "to": "icon.png"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "icon": "../icon_server.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kasalix-AI-Chat-Server.exe",
      "sign": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "guid": "com-kasalix-server",
      "createDesktopShortcut": true,
      "shortcutName": "Kasalix AI Chat Server",
      "artifactName": "Kasalix-AI-Chat-Server-${version}.exe",
      "runAfterFinish": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
